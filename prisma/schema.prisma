generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model User {
  id         String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  username   String     @unique
  password   String
  name       String
  email      String?    @unique
  role       UserRole   @default(ADMIN)
  is_active  Boolean    @default(true)
  last_login DateTime?  @db.Timestamptz(6)
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @default(now()) @db.Timestamptz(6)
  visit_logs VisitLog[]

  @@map("users")
}

model Department {
  id                String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  code              String       @unique
  name              String
  description       String?
  parent_id         String?
  order             Int          @default(0)
  is_active         Boolean      @default(true)
  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime     @default(now()) @db.Timestamptz(6)
  departments       Department?  @relation("departmentsTodepartments", fields: [parent_id], references: [id], onUpdate: NoAction)
  other_departments Department[] @relation("departmentsTodepartments")
  visitors          Visitor[]

  @@index([parent_id], map: "idx_departments_parent_id")
  @@map("departments")
}

model RegisterCounter {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  year       Int      @unique
  counter    Int      @default(0)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("register_counter")
}

model Visitor {
  id              String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  register_number String         @unique
  name            String
  address         String
  phone           String
  purpose         String
  department_id   String
  status          VisitorStatus  @default(REGISTERED)
  notes           String?
  visit_date      DateTime       @default(now()) @db.Timestamptz(6)
  checkout_time   DateTime?      @db.Timestamptz(6)
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime       @default(now()) @db.Timestamptz(6)
  uploaded_files  UploadedFile[]
  visit_logs      VisitLog[]
  departments     Department     @relation(fields: [department_id], references: [id], onUpdate: NoAction)

  @@index([department_id], map: "idx_visitors_department_id")
  @@index([register_number], map: "idx_visitors_register_number")
  @@index([status], map: "idx_visitors_status")
  @@index([visit_date(sort: Desc)], map: "idx_visitors_visit_date")
  @@map("visitors")
}

model UploadedFile {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  visitor_id    String
  original_name String
  stored_name   String
  file_path     String
  file_type     String
  file_size     Int
  mime_type     String
  uploaded_at   DateTime @default(now()) @db.Timestamptz(6)
  visitors      Visitor  @relation(fields: [visitor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([visitor_id], map: "idx_uploaded_files_visitor_id")
  @@map("uploaded_files")
}

model VisitLog {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  visitor_id String?
  user_id    String?
  action     LogAction
  details    String?
  ip_address String?
  user_agent String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      User?     @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  visitors   Visitor?  @relation(fields: [visitor_id], references: [id], onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_visit_logs_created_at")
  @@index([user_id], map: "idx_visit_logs_user_id")
  @@index([visitor_id], map: "idx_visit_logs_visitor_id")
  @@map("visit_logs")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  PTSP
  VIEWER
}

enum VisitorEntrySource {
  PUBLIC_FORM
  ADMIN_FORM
}

enum VisitorStatus {
  REGISTERED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CHECKED_OUT
  CANCELLED
}

enum LogAction {
  VISITOR_REGISTERED
  VISITOR_UPDATED
  VISITOR_DELETED
  VISITOR_CHECKED_IN
  VISITOR_CHECKED_OUT
  FILE_UPLOADED
  FILE_DELETED
  ADMIN_LOGIN
  ADMIN_LOGOUT
  DATA_EXPORTED
}
